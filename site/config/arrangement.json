{
 "note": "Arrangement of three components, with the same names as theme.json and sizes.json (screen.component.part). `parts` is the order in which the parts appear; a part is drawn when its `show` condition holds and it has something to show, the CR box and Value chip of Players are always part of the layout (a dash frame without data); setting their `show` to `when-data` again hides them while there is no data. `align: end` puts a part in the group at the far end of the row. direction, wrap, align, justify and push of a container, and `self` (own alignment) of a part, become CSS variables in arrangement.css (node site/config/generate.mjs). show: always | fantasy (the Fantasy area; used by the top bar) | players | teams | charts-available | when-data | team-from-player | logo-fallback (teams, and players without a portrait).",
 "component": {
  "app": {
   "top-bar": {
    "bar": {
     "parts": [
      { "name": "coverage", "show": "fantasy" }
     ]
    },
    "coverage": {
     "push": "end"
    }
   }
  },
  "fantasy": {
   "stat-table": {
    "players-view-row": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center",
     "justify": "end",
     "parts": [
      { "name": "view-button", "show": "always" },
      { "name": "players-view-divider", "show": "charts-available" },
      { "name": "mode-tabs", "show": "charts-available" }
     ]
    },
    "players-toolbar": {
     "direction": "row",
     "wrap": "wrap",
     "align": "center",
     "justify": "start",
     "parts": [
      { "name": "window-buttons", "show": "always" },
      { "name": "position-buttons", "show": "players", "align": "end" },
      { "name": "search", "show": "always", "align": "end" },
      { "name": "filters-button", "show": "players", "align": "end" }
     ]
    },
    "players-toolbar-end-group": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center",
     "push": "end"
    },
    "players-window-buttons": {
     "direction": "row",
     "wrap": "wrap",
     "align": "center"
    },
    "players-position-buttons": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center"
    },
    "players-view-buttons": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center"
    },
    "players-mode-buttons": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center"
    },
    "players-view-button": {
     "direction": "column",
     "align": "center",
     "justify": "center",
     "parts": [
      { "name": "players-view-icon", "show": "always" },
      { "name": "label", "show": "always" }
     ]
    },
    "players-mode-button": {
     "direction": "column",
     "align": "center",
     "justify": "center",
     "parts": [
      { "name": "players-mode-icon", "show": "always" },
      { "name": "label", "show": "always" }
     ]
    },
    "players-view-divider": {
     "align": "center"
    },
    "players-search": {
     "direction": "row",
     "align": "center",
     "parts": [
      { "name": "players-search-icon", "show": "always" },
      { "name": "players-search-field", "show": "always" }
     ]
    },
    "players-filters-button": {
     "direction": "row",
     "align": "center",
     "justify": "center",
     "parts": [
      { "name": "players-filters-icon", "show": "always" }
     ]
    },
    "name-cell": {
     "direction": "column",
     "align": "stretch",
     "parts": [
      { "name": "name", "show": "always", "self": "start" }
     ]
    },
    "players-name-cell": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center",
     "parts": [
      { "name": "name-cell-position-badge", "show": "players" },
      { "name": "name-cell-identity", "show": "always" },
      { "name": "name-cell-figures", "show": "always" }
     ]
    },
    "name-cell-identity": {
     "direction": "column",
     "align": "start",
     "parts": [
      { "name": "name", "show": "always" },
      { "name": "team-and-position", "show": "players" }
     ]
    },
    "name-cell-name": {
     "parts": [
      { "name": "name-cell-given-name", "show": "players" },
      { "name": "name-cell-family-name", "show": "players" }
     ]
    },
    "name-cell-position-badge": {
     "align": "center"
    },
    "name-cell-figures": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center",
     "push": "end",
     "parts": [
      { "name": "cr-box", "show": "always" },
      { "name": "value-chip", "show": "always" }
     ]
    },
    "name-cell-cr-box": {
     "align": "center"
    },
    "name-cell-value-chip": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center",
     "parts": [
      { "name": "name-cell-value", "show": "always" },
      { "name": "name-cell-sparkline", "show": "always" }
     ]
    }
   },
   "player-card": {
    "header": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "start",
     "justify": "start",
     "parts": [
      { "name": "header-identity", "show": "always" },
      { "name": "header-actions", "show": "always", "self": "start" }
     ]
    },
    "header-team": {
     "direction": "row",
     "wrap": "wrap",
     "align": "center",
     "justify": "start",
     "parts": [
      { "name": "logo", "show": "always" },
      { "name": "title", "show": "always" },
      { "name": "header-actions-team", "show": "always" }
     ]
    },
    "header-actions-team": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center",
     "parts": [
      { "name": "back-button", "show": "team-from-player" },
      { "name": "close-button", "show": "always" }
     ]
    },
    "header-identity": {
     "direction": "row",
     "wrap": "wrap",
     "align": "center",
     "justify": "start",
     "parts": [
      { "name": "logo", "show": "logo-fallback" },
      { "name": "header-portrait", "show": "players" },
      { "name": "title", "show": "always" },
      { "name": "cr-box", "show": "always" },
      { "name": "value-chip", "show": "always" },
      { "name": "value-sparkline", "show": "always" }
     ]
    },
    "header-portrait": {
     "parts": [
      { "name": "header-portrait-fade", "show": "always" }
     ]
    },
    "header-actions": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center",
     "push": "end",
     "parts": [
      { "name": "next-game-button", "show": "players" },
      { "name": "back-button", "show": "team-from-player" },
      { "name": "close-button", "show": "always" }
     ]
    },
    "header-title": {
     "parts": [
      { "name": "header-given-name", "show": "players" },
      { "name": "name", "show": "always" },
      { "name": "team-line", "show": "always" }
     ]
    },
    "controls": {
     "direction": "row",
     "wrap": "wrap",
     "align": "center",
     "justify": "space-between",
     "parts": [
      { "name": "window-buttons", "show": "always" },
      { "name": "games-played", "show": "players" },
      { "name": "view-button", "show": "always" }
     ]
    },
    "window-buttons": {
     "direction": "row",
     "wrap": "wrap",
     "align": "center"
    },
    "controls-games-played-group": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center",
     "push": "end",
     "parts": [
      { "name": "controls-games-played-divider", "show": "players" },
      { "name": "controls-games-played", "show": "players" }
     ]
    },
    "controls-games-played-divider": {
     "align": "center"
    },
    "view-buttons": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center",
     "push": "end"
    },
    "view-button": {
     "direction": "column",
     "align": "center",
     "justify": "center",
     "parts": [
      { "name": "view-icon", "show": "always" },
      { "name": "label", "show": "always" }
     ]
    }
   }
  }
 }
}
