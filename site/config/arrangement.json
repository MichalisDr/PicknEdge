     ]
    },
    "players-name-cell": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center",
     "parts": [
      { "name": "name-cell-position-badge", "show": "players" },
      { "name": "name-cell-identity", "show": "always" },
      { "name": "name-cell-figures", "show": "when-data" }
