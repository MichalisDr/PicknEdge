    "name-cell-value-chip": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center",
     "parts": [
      { "name": "name-cell-value", "show": "always" },
      { "name": "name-cell-sparkline", "show": "when-data" }
     ]
    }
   },
   "player-card": {
    "header": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "end",
     "justify": "start",
     "parts": [
      { "name": "header-portrait-fade", "show": "has-portrait" },
      { "name": "header-identity", "show": "always" },
      { "name": "header-actions", "show": "always", "self": "center" }
     ]
    },
    "header-team": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center",
