{
 "note": "Arrangement of three components, with the same names as theme.json and sizes.json (screen.component.part). `parts` is the order in which the parts appear; a part is drawn when its `show` condition holds and it has something to show, so optional parts (cr-box, value-chip) draw nothing while there is no data. `align: end` puts a part in the group at the far end of the row. direction, wrap, align, justify and push of a container, and `self` (own alignment) of a part, become CSS variables in arrangement.css (node site/config/generate.mjs). show: always | has-portrait (player cards with a portrait) | teams (also on cards) | fantasy (the Fantasy area; used by the top bar) | players | teams | charts-available | when-data | team-from-player | logo-fallback (teams, and players without a portrait).",
 "component": {
  "app": {
   "top-bar": {
    "bar": {
     "parts": [
      { "name": "coverage", "show": "fantasy" }
     ]
    },
    "coverage": {
     "push": "end"
    }
   }
  },
  "fantasy": {
   "stat-table": {
    "players-view-row": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center",
     "justify": "end",
     "parts": [
      { "name": "view-button", "show": "always" },
      { "name": "players-view-divider", "show": "charts-available" },
      { "name": "mode-tabs", "show": "charts-available" }
     ]
    },
    "players-toolbar": {
     "direction": "row",
     "wrap": "wrap",
     "align": "center",
     "justify": "start",
     "parts": [
      { "name": "window-buttons", "show": "always" },
      { "name": "position-buttons", "show": "players" },
      { "name": "players-search-group", "show": "always" }
     ]
    },
    "title-row": {
     "direction": "row",
     "wrap": "wrap",
     "align": "center",
     "justify": "space-between",
     "parts": [
      { "name": "heading-title", "show": "always" },
      { "name": "players-view-row", "show": "always" }
     ]
    },
    "players-search-group": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center",
     "parts": [
      { "name": "search", "show": "always" },
      { "name": "sort-value-button", "show": "players" },
      { "name": "filters-button", "show": "players" }
     ]
    },
    "players-window-buttons": {
     "direction": "row",
     "wrap": "wrap",
     "align": "center"
    },
    "players-position-buttons": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center"
    },
    "players-view-buttons": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center"
    },
    "players-mode-buttons": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center"
    },
    "players-view-button": {
     "direction": "column",
     "align": "center",
     "justify": "center",
     "parts": [
      { "name": "players-view-icon", "show": "always" },
      { "name": "label", "show": "always" }
     ]
    },
    "players-mode-button": {
     "direction": "column",
     "align": "center",
     "justify": "center",
     "parts": [
      { "name": "players-mode-icon", "show": "always" },
      { "name": "label", "show": "always" }
     ]
    },
    "players-view-divider": {
     "align": "center"
    },
    "players-search": {
     "direction": "row",
     "align": "center",
     "parts": [
      { "name": "players-search-icon", "show": "always" },
      { "name": "players-search-field", "show": "always" }
     ]
    },
    "players-sort-value-button": {
     "direction": "row",
     "align": "center",
     "justify": "center",
     "parts": [
      { "name": "players-sort-value-icon", "show": "always" },
      { "name": "players-sort-value-label", "show": "always" }
     ]
    },
    "players-filters-button": {
     "direction": "row",
     "align": "center",
     "justify": "center",
     "parts": [
      { "name": "players-filters-icon", "show": "always" }
     ]
    },
    "name-cell": {
     "direction": "column",
     "align": "stretch",
