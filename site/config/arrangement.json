     ]
    },
    "value-chip": {
     "direction": "row",
     "align": "center",
     "parts": [
      { "name": "value-chip-label", "show": "always" },
      { "name": "value-chip-value", "show": "always" },
      { "name": "value-sparkline", "show": "when-data" }
     ]
    },
    "team-line": {
     "direction": "row",
     "align": "center",
     "parts": [
      { "name": "team-line-position", "show": "always" },
      { "name": "team-line-divider", "show": "always" },
      { "name": "team-line-team", "show": "always" }
     ]
    },
    "next-game-button": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center",
     "parts": [
      { "name": "next-game-label", "show": "always" },
      { "name": "next-game-logo", "show": "always" }
     ]
    },
    "header-actions": {
     "direction": "row",
     "wrap": "nowrap",
     "align": "center",
     "parts": [
      { "name": "next-game-button", "show": "players" },
      { "name": "back-button", "show": "team-from-player" },
      { "name": "close-button", "show": "always" }
     ]
    },
    "header-title": {
     "parts": [
      { "name": "header-given-name", "show": "players" },
      { "name": "name", "show": "always" },
      { "name": "header-city", "show": "teams" },
      { "name": "team-line", "show": "always" }
     ]
    },
    "controls": {
